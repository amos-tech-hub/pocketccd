    "Pocket CCD does not create an account, run advertising SDKs, or send product analytics to a server. Onboarding, capture, sharing, and purchase counters are stored only on this device." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pocket CCD does not create an account, run advertising SDKs, or send product analytics to a server. Onboarding, capture, sharing, and purchase counters are stored only on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pocket CCD 不创建账号、不接入广告 SDK，也不向服务器发送产品分析数据。引导、拍摄、分享与购买计数只保存在本机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pocket CCD 不創建帳號、不接入廣告 SDK，也不向伺服器發送產品分析資料。引導、拍攝、分享與購買計數只儲存在本機。"
          }
        }
      }
    },
