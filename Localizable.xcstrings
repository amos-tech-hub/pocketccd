        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三连闪快速连拍，自动推荐睁眼最好的一张"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三連閃快速連拍，自動推薦睜眼最好的一張"
          }
        }
      }
    },
    "A short flash burst that recommends the best frame." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
