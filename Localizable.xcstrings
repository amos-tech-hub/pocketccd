    "A less-perfect frame with a little more surprise. It’s only a suggestion—every original stays in the roll." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A less-perfect frame with a little more surprise. It’s only a suggestion—every original stays in the roll."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一张没那么完美、却更有惊喜的照片。这只是建议——所有原片都会保留在胶卷中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一張沒那麼完美、卻更有驚喜的照片。這只是建議——所有原片都會保留在相簿中。"
          }
        }
      }
    },
    "A short burst that recommends the best face and eyes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A short burst that recommends the best face and eyes"
