    },
    "Every capture joins a 24-frame roll. Add a note, make a contact sheet, or turn the day into a short memory film." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every capture joins a 24-frame roll. Add a note, make a contact sheet, or turn the day into a short memory film."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次拍摄都会进入一卷 24 张的胶卷。可以加备注、做接触印样，或把这一天剪成一段短片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次拍攝都會進入一捲 24 張的膠卷。可以加註記、做接觸印樣，或把這一天剪成一段短片。"
          }
        }
      }
    },
