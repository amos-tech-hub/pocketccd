        }
      }
    },
    "A7 and A8 stay free forever. Add C1 and N2 with one purchase." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A7 and A8 stay free forever. Add C1 and N2 with one purchase."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A7 与 A8 永久免费。一次购买解锁 C1 与 N2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A7 與 A8 永久免費。一次購買解鎖 C1 與 N2。"
          }
        }
      }
    },
    "A7 and A8 stay free forever. One purchase unlocks every other camera body." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A7 and A8 stay free forever. One purchase unlocks every other camera body."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A7 和 A8 永久免费，一次购买解锁其余所有机身。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A7 和 A8 永久免費，一次購買解鎖其餘所有機身。"
          }
        }
      }
    },
    "A7 is warm, C1 is crisp, and N2 owns the night. Each keeps the same character from preview to photo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A7 is warm, C1 is crisp, and N2 owns the night. Each keeps the same character from preview to photo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A7 温暖，C1 锐利，N2 属于夜晚。从取景到成片，每一台都保持同一种性格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A7 溫暖，C1 銳利，N2 屬於夜晚。從取景到成片，每一台都保持同一種性格。"
          }
        }
      }
