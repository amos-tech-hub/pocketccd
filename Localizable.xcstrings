        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄两秒片段，可保存静态照片或实况照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
