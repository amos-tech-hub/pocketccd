  "strings": {
    "CFBundleDisplayName": {
      "comment": "Bundle display name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketCCD"
          }
        },
        "zh-Hans": {
          "stringUnit": {
